{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EigenLab — Image Transformation &amp; Eigen‑Feature Analyzer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{% static 'analyzer/base.css' %}">
    <link rel="stylesheet" href="{% static 'analyzer/styles.css' %}">
</head>
<body>
<div class="ambient ambient-blue"></div>
<div class="ambient ambient-violet"></div>
<div class="math-grid"></div>

<header class="topbar" id="topbar">
    <div class="brand">
        <div class="brand-mark">λ</div>
        <div class="brand-text">
            <span class="brand-name">EigenLab</span>
        </div>
    </div>
    <div class="system-status">
        <span class="status-dot"></span>
        <span>Analysis Engine Ready</span>
    </div>
</header>

<main class="page-shell">

    <!-- ── Hero ── -->
    <section class="hero" data-anim="fade-up">
        <span class="hero-watermark" aria-hidden="true">λ</span>
        <span class="hero-kicker">Linear Algebra &amp; Vector Calculus Mini Project</span>
        <h1>Image Transformation &amp; <em>Eigen‑Feature</em> Analyzer</h1>
        <p class="hero-description">Turn your pictures into mathematical matrices, explore eigen‑directions, and visualize reconstruction error — all in real time.</p>
        <div class="hero-tags">
            <span>Matrix Rank</span>
            <span>Eigenvalues</span>
            <span>Projection</span>
            <span>Reconstruction</span>
            <span>Error Analysis</span>
        </div>

        <div class="hero-equation">
            <div class="equation-ring ring-one"></div>
            <div class="equation-ring ring-two"></div>
            <p class="equation-label">Pipeline Summary</p>
            <p class="equation-main">Image → A → A<sup>T</sup>A → λ, V → V<sub>k</sub> → P = AV<sub>k</sub> → A<sub>k</sub> = PV<sub>k</sub><sup>T</sup> → Error</p>
            <p class="equation-sub">Eight-step computational sequence powered by NumPy</p>
        </div>
    </section>

    <!-- ── Workflow steps ── -->
    <section class="workflow-section" data-anim="fade-up">
        <div class="section-heading">
            <div>
                <span class="section-eyebrow">Computational Sequence</span>
                <h2>Eight‑Step Pipeline</h2>
            </div>
            <span class="section-note">Each step builds on the previous</span>
        </div>

        <div class="workflow" data-stagger="0.06">
            <div class="workflow-step"><span>01</span><strong>Image → Matrix</strong><small>Convert to normalised grayscale matrix</small></div>
            <div class="workflow-step"><span>02</span><strong>Matrix Rank</strong><small>Count independent rows/columns</small></div>
            <div class="workflow-step"><span>03</span><strong>Eigen Analysis</strong><small>Extract eigenvalues &amp; eigenvectors</small></div>
            <div class="workflow-step"><span>04</span><strong>Component Selection</strong><small>Pick top‑k eigen‑directions</small></div>
            <div class="workflow-step"><span>05</span><strong>Projection</strong><small>Project matrix onto subspace</small></div>
            <div class="workflow-step"><span>06</span><strong>Reconstruction</strong><small>Rebuild image from projection</small></div>
            <div class="workflow-step"><span>07</span><strong>Error Analysis</strong><small>Frobenius &amp; relative error</small></div>
            <div class="workflow-step"><span>08</span><strong>Interpretation</strong><small>Mathematical summary</small></div>
        </div>
    </section>

    <!-- ── Error notice ── -->
    {% if error %}
    <div class="notice" data-anim="fade-up">
        <span class="notice-icon">!</span>
        <p>{{ error }}</p>
    </div>
    {% endif %}

    <!-- ── Control panel (upload + k slider) ── -->
    <section class="control-panel" data-anim="fade-up">
        <div class="control-header">
            <h2>Run Analysis</h2>
            <span class="lab-chip">EIGENLAB v1.0</span>
        </div>

        <form id="analysisForm" method="post" enctype="multipart/form-data" class="upload-form">
            {% csrf_token %}
            <input type="hidden" name="image_name" value="{{ image_name }}">

            <div class="drop-zone" id="dropZone">
                <input type="file" id="imageInput" name="image" accept="image/*">
                <div class="upload-icon" aria-hidden="true">↑</div>
                <p class="drop-title">Upload Image</p>
                <p class="drop-subtitle" id="fileName">PNG, JPG, JPEG or other image</p>
                <p class="drop-action">Drop file or click to browse</p>
            </div>

            <div class="k-control">
                <div class="control-label">
                    <span>Dominant components k</span>
                    <span id="kValue">{{ result.selected_k|default:"8" }}</span>
                </div>
                <input type="range" id="kRange" name="k" min="1" max="{{ result.max_k|default:64 }}" value="{{ result.selected_k|default:8 }}">
                <div class="range-scale">
                    <span>1</span>
                    <span>{{ result.max_k|default:64 }}</span>
                </div>
                <p class="range-help">Higher k preserves more detail but uses more components</p>
            </div>

            <button type="submit" class="run-button" id="runBtn">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                <span>Run Analysis</span>
                <b>k = <span class="run-k-echo">{{ result.selected_k|default:"8" }}</span></b>
            </button>
        </form>
    </section>

    {% if result %}
    <!-- ── Summary metrics ── -->
    <div class="result-header" data-anim="fade-up">
        <div>
            <span class="section-eyebrow">Analysis Complete</span>
            <h2>Results for k = {{ result.selected_k }}</h2>
        </div>
        <div class="result-status">
            <span class="status-dot"></span>
            <span>{{ result.orthogonality_status }}</span>
        </div>
    </div>

    <div class="summary-grid" data-anim="fade-up" data-stagger="0.06">
        <div class="metric-card">
            <span>Matrix Size</span>
            <strong>{{ result.matrix_shape }}</strong>
            <small>Grayscale pixels</small>
        </div>
        <div class="metric-card">
            <span>Rank</span>
            <strong>{{ result.rank }}</strong>
            <small>Independent dimensions</small>
        </div>
        <div class="metric-card feature">
            <span>Selected k</span>
            <strong>{{ result.selected_k }}</strong>
            <small>Dominant components</small>
        </div>
        <div class="metric-card">
            <span>Min Pixel</span>
            <strong>{{ result.matrix_min|floatformat:4 }}</strong>
        </div>
        <div class="metric-card">
            <span>Max Pixel</span>
            <strong>{{ result.matrix_max|floatformat:4 }}</strong>
        </div>
        <div class="metric-card">
            <span>Frobenius Error</span>
            <strong>{{ result.frobenius_error|floatformat:4 }}</strong>
        </div>
        <div class="metric-card">
            <span>Relative Error</span>
            <strong>{{ result.relative_error|floatformat:4 }}%</strong>
        </div>
        <div class="metric-card verified">
            <span>Orthogonality</span>
            <strong>{{ result.orthogonality_status }}</strong>
        </div>
    </div>

    <!-- ── Image comparison ── -->
    <div class="image-comparison" data-anim="fade-up">
        <figure class="image-card">
            <div class="image-card-header">
                <span class="image-title"><span class="image-badge">A</span> Original</span>
                <span>64 × 64</span>
            </div>
            <div class="image-frame">
                <img src="{{ result.original_image }}" alt="Original grayscale image">
            </div>
            <figcaption>Original 64 × 64 grayscale matrix</figcaption>
        </figure>

        <figure class="image-card">
            <div class="image-card-header">
                <span class="image-title"><span class="image-badge">A<sub>k</sub></span> Reconstructed</span>
                <span>k = {{ result.selected_k }}</span>
            </div>
            <div class="image-frame">
                <img src="{{ result.reconstructed_image }}" alt="Reconstructed image">
            </div>
            <figcaption>Reconstructed image using k = {{ result.selected_k }} components</figcaption>
        </figure>
    </div>

    <!-- ── Mathematical breakdown ── -->
    <div class="analysis-divider" data-anim="fade-up">
        <i></i>
        <span>Mathematical Breakdown</span>
        <i></i>
    </div>

    <div class="analysis-layout">
        <!-- Step 01 — Matrix Representation -->
        <article class="panel wide-panel" data-anim="fade-up">
            <span class="step-number">01</span>
            <div class="panel-heading">
                <span class="mini-label">Step 01</span>
                <h2>Matrix Representation</h2>
                <p>Image data becomes a numerical matrix.</p>
            </div>
            <div class="formula">A ∈ ℝ<sup>64 × 64</sup>, 0 ≤ A[i,j] ≤ 1</div>
            <p class="result-line">A dimensions = <b>{{ result.matrix_shape }}</b></p>
            <p class="result-line">Pixel range = <b>[{{ result.matrix_min|floatformat:4 }}, {{ result.matrix_max|floatformat:4 }}]</b>; range check = <b>{{ result.matrix_normalized|yesno:"Passed,Failed" }}</b></p>
            <p class="meaning">The uploaded image is converted to grayscale, resized to 64 × 64, and normalised so every entry in A is a real number between 0 and 1.</p>
        </article>

        <!-- Step 02 — Matrix Rank -->
        <article class="panel" data-anim="fade-up">
            <span class="step-number">02</span>
            <div class="panel-heading">
                <span class="mini-label">Step 02</span>
                <h2>Matrix Rank</h2>
                <p>Rank is not the selected k value.</p>
            </div>
            <div class="formula">rank(A)</div>
            <div class="big-result">rank(A) = <b>{{ result.rank }}</b></div>
            <p class="meaning">The rank tells us the number of linearly independent rows (or columns) in A. Full rank = {{ result.matrix_cols }}.</p>
        </article>

        <!-- Step 03 — Eigen Analysis -->
        <article class="panel" data-anim="fade-up">
            <span class="step-number">03</span>
            <div class="panel-heading">
                <span class="mini-label">Step 03</span>
                <h2>Eigen Analysis</h2>
                <p>Compute covariance, eigenvalues &amp; eigenvectors.</p>
            </div>
            <div class="formula">A<sup>T</sup>A v = λ v</div>
            <p class="result-line">Covariance shape = <b>{{ result.covariance_shape }}</b></p>
            <p class="result-line">Eigenvalues sorted descending = <b>{{ result.eigenvalues_sorted|yesno:"Yes,No" }}</b></p>
            <p class="result-line">All eigenvalues ≥ 0 = <b>{{ result.eigenvalues_nonnegative|yesno:"Yes,No" }}</b></p>
            <p class="result-line">Dominant 6: <b>{{ result.dominant_eigenvalues }}</b></p>
            <div class="dimension-box">Eigenvectors (first 5): <b>{{ result.dominant_eigenvector_shape }}</b></div>
            {% include 'analyzer/table_preview.html' with data=result.dominant_eigenvectors_preview %}
            <p class="meaning">A<sup>T</sup>A is symmetric positive semi-definite, so eigenvalues are non-negative. Larger eigenvalues correspond to more important directions.</p>
        </article>

        <!-- Step 04 — Component Selection -->
        <article class="panel" data-anim="fade-up">
            <span class="step-number">04</span>
            <div class="panel-heading">
                <span class="mini-label">Step 04</span>
                <h2>Component Selection</h2>
                <p>The first k dominant eigenvectors are selected.</p>
            </div>
            <div class="formula">V<sub>k</sub> = [v<sub>1</sub> v<sub>2</sub> … v<sub>k</sub>]</div>
            <p class="result-line">Selected k = <b>{{ result.selected_k }}</b></p>
            <p class="result-line">V<sub>k</sub> dimensions = <b>{{ result.vk_shape }}</b></p>
            <p class="meaning">These eigenvectors form the dominant subspace used to approximate the image.</p>
        </article>

        <!-- Step 05 — Projection -->
        <article class="panel" data-anim="fade-up">
            <span class="step-number">05</span>
            <div class="panel-heading">
                <span class="mini-label">Step 05</span>
                <h2>Projection</h2>
                <p>The image matrix is projected into the selected subspace.</p>
            </div>
            <div class="formula">P = AV<sub>k</sub></div>
            <p class="result-line"><b>{{ result.dimension_equation }}</b></p>
            <p class="result-line">A = <b>{{ result.matrix_shape }}</b>, V<sub>k</sub> = <b>{{ result.vk_shape }}</b>, P = <b>{{ result.projection_shape }}</b></p>
            <p class="meaning">Projection expresses A using the coordinate directions in V<sub>k</sub>.</p>
        </article>

        <!-- Step 06 — Reconstruction -->
        <article class="panel" data-anim="fade-up">
            <span class="step-number">06</span>
            <div class="panel-heading">
                <span class="mini-label">Step 06</span>
                <h2>Reconstruction</h2>
                <p>The approximation is rebuilt from projected data.</p>
            </div>
            <div class="formula">A<sub>k</sub> = PV<sub>k</sub><sup>T</sup></div>
            <p class="result-line"><b>{{ result.reconstruction_dimension_equation }}</b></p>
            <p class="result-line">P = <b>{{ result.projection_shape }}</b>, V<sub>k</sub><sup>T</sup> = <b>{{ result.vk_transpose_shape }}</b>, A<sub>k</sub> = <b>{{ result.reconstruction_shape }}</b></p>
            <p class="meaning">A<sub>k</sub> is an approximation of A using only k dominant eigen-components.</p>
        </article>

        <!-- Step 07 — Error Analysis -->
        <article class="panel wide-panel" data-anim="fade-up">
            <span class="step-number">07</span>
            <div class="panel-heading">
                <span class="mini-label">Step 07</span>
                <h2>Error Analysis</h2>
                <p>Original matrix and reconstructed matrix are compared.</p>
            </div>
            <div class="formula">E<sub>absolute</sub> = ‖A − A<sub>k</sub>‖<sub>F</sub></div>
            <div class="formula">E<sub>relative</sub> = ‖A − A<sub>k</sub>‖<sub>F</sub> / ‖A‖<sub>F</sub> × 100</div>
            <div class="error-grid">
                <div>
                    <span>Absolute Frobenius Error</span>
                    <strong>{{ result.frobenius_error|floatformat:4 }}</strong>
                </div>
                <div>
                    <span>Relative Error</span>
                    <strong>{{ result.relative_error|floatformat:4 }}%</strong>
                </div>
            </div>
            <p class="meaning">The relative error reports the reconstruction difference as a percentage of the original matrix norm.</p>
        </article>

        <!-- Step 08 — Mathematical Interpretation -->
        <article class="panel wide-panel interpretation-card" data-anim="fade-up">
            <span class="step-number">08</span>
            <div class="interpretation-symbol" aria-hidden="true">∫</div>
            <div class="panel-heading">
                <span class="mini-label">Step 08</span>
                <h2>Mathematical Interpretation</h2>
                <p>Concise viva explanation</p>
            </div>
            <p class="interpretation-text">The image is treated as a matrix A. Rank(A) describes independent structure in that matrix. The eigenvectors of A<sup>T</sup>A give orthogonal directions in the image vector space. Selecting k dominant eigenvectors gives a lower-dimensional representation. Projection calculates P = AV<sub>k</sub>, reconstruction calculates A<sub>k</sub> = PV<sub>k</sub><sup>T</sup>, and the Frobenius error measures how much information is lost.</p>
            <div class="viva-callout">
                <b>For this upload:</b> k = {{ result.selected_k }}, rank(A) = {{ result.rank }}, relative error = {{ result.relative_error|floatformat:4 }}%.
            </div>
        </article>

        <!-- Component Comparison Table -->
        <article class="panel wide-panel" data-anim="fade-up">
            <div class="panel-heading">
                <span class="mini-label">Comparison</span>
                <h2>Component Comparison</h2>
                <p>Each row is calculated independently for k = 1, 5, 10, 20, 32, 64.</p>
            </div>
            <div class="comparison-table-wrap">
                <table class="comparison-table">
                    <thead>
                        <tr>
                            <th>k</th>
                            <th>Frobenius Error</th>
                            <th>Relative Error (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in result.error_series %}
                        <tr>
                            <td>{{ row.k }}</td>
                            <td>{{ row.error }}</td>
                            <td>{{ row.relative_error }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </article>

        <!-- Eigenvalue Spectrum chart -->
        <article class="panel wide-panel" data-anim="fade-up">
            <div class="panel-heading">
                <span class="mini-label">Spectrum</span>
                <h2>Eigenvalue Spectrum</h2>
                <p>Computed from A<sup>T</sup>A and sorted descending.</p>
            </div>
            <div class="chart-wrap">
                <canvas id="eigenChart" height="230" data-values="{{ result.eigenvalues|join:',' }}"></canvas>
            </div>
        </article>

        <!-- Matrix A Preview -->
        <article class="panel" data-anim="fade-up">
            <div class="panel-heading">
                <span class="mini-label">Preview</span>
                <h2>Matrix A Preview</h2>
                <p>First 10 rows and columns after normalisation.</p>
            </div>
            {% include 'analyzer/table_preview.html' with data=result.matrix_preview %}
        </article>

        <!-- Projection P Preview -->
        <article class="panel" data-anim="fade-up">
            <div class="panel-heading">
                <span class="mini-label">Preview</span>
                <h2>Projection P Preview</h2>
                <p>First rows of P = AV<sub>k</sub>.</p>
            </div>
            {% include 'analyzer/table_preview.html' with data=result.projection_preview %}
        </article>

        <!-- Orthogonality Verification -->
        <article class="panel wide-panel" data-anim="fade-up">
            <div class="panel-heading">
                <span class="mini-label">Verification</span>
                <h2>Orthogonality Verification</h2>
                <p>Selected eigenvectors should form an orthonormal basis.</p>
            </div>
            <div class="verification-row">
                <div class="formula">V<sub>k</sub><sup>T</sup>V<sub>k</sub> ≈ I<sub>k</sub></div>
                <div class="verification-result">
                    <span>Error</span>
                    <strong>{{ result.orthogonality_error|floatformat:10 }}</strong>
                    <em>{{ result.orthogonality_status }}</em>
                </div>
            </div>
            {% include 'analyzer/table_preview.html' with data=result.eigenvectors_preview %}
        </article>
    </div>

    {% else %}
    <!-- ── Empty state ── -->
    <section class="empty-state" data-anim="fade-up">
        <div class="empty-symbol" aria-hidden="true">λ</div>
        <h2>Upload an image to begin</h2>
        <p>The image will be converted to grayscale, resized to 64 × 64, converted into matrix A, analyzed through A<sup>T</sup>A, projected onto dominant eigenvectors, reconstructed, and compared with the original matrix.</p>
        <div class="empty-flow">
            <span>Upload</span> <b>→</b>
            <span>Matrix</span> <b>→</b>
            <span>Eigen</span> <b>→</b>
            <span>Project</span> <b>→</b>
            <span>Reconstruct</span> <b>→</b>
            <span>Compare</span>
        </div>
    </section>
    {% endif %}

    <footer class="footer">
        <span>EigenLab — Linear Algebra Mini Project</span>
        <span>Built with Django · NumPy</span>
    </footer>
</main>

<script src="{% static 'analyzer/app.js' %}"></script>
<script src="{% static 'analyzer/motion.js' %}"></script>
</body>
</html>