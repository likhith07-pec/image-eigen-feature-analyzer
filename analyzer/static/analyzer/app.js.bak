/* =========================================================
   EIGENLAB — INTERACTION & VISUALIZATION
========================================================= */

document.addEventListener("DOMContentLoaded", () => {
    const kRange = document.getElementById("kRange");
    const kValue = document.getElementById("kValue");
    const imageInput = document.getElementById("imageInput");
    const fileName = document.getElementById("fileName");
    const dropZone = document.querySelector(".drop-zone");
    const analysisForm = document.getElementById("analysisForm");
    const runButton = document.querySelector(".run-button");

    /* K slider */
    function updateKValue() {
        if (!kRange || !kValue) return;

        kValue.textContent = kRange.value;

        const min = Number(kRange.min || 1);
        const max = Number(kRange.max || 64);
        const value = Number(kRange.value);
        const percentage = max > min
            ? ((value - min) / (max - min)) * 100
            : 0;

        kRange.style.setProperty("--slider-progress", `${percentage}%`);

        /* Sync the k echo in the run button */
        const kEcho = document.querySelector(".run-k-echo");
        if (kEcho) kEcho.textContent = kRange.value;
    }

    if (kRange) {
        kRange.addEventListener("input", updateKValue);
        updateKValue();
    }

    /* File selection */
    function displayFile(file) {
        if (!file || !fileName) return;
        fileName.textContent = file.name;
        fileName.style.color = "#d8b36a";
    }

    if (imageInput) {
        imageInput.addEventListener("change", () => {
            const file = imageInput.files?.[0];
            if (file) {
                displayFile(file);
            } else if (fileName) {
                fileName.textContent = "PNG, JPG, JPEG or other image";
                fileName.style.color = "";
            }
        });
    }

    /* Drag and drop */
    if (dropZone && imageInput) {
        ["dragenter", "dragover"].forEach(name => {
            dropZone.addEventListener(name, event => {
                event.preventDefault();
                dropZone.classList.add("drag-active");
            });
        });

        ["dragleave", "drop"].forEach(name => {
            dropZone.addEventListener(name, event => {
                event.preventDefault();
                dropZone.classList.remove("drag-active");
            });
        });

        dropZone.addEventListener("drop", event => {
            const file = event.dataTransfer?.files?.[0];
            if (!file || !file.type.startsWith("image/")) return;

            try {
                const transfer = new DataTransfer();
                transfer.items.add(file);
                imageInput.files = transfer.files;
                displayFile(file);
                imageInput.dispatchEvent(new Event("change", { bubbles: true }));
            } catch (error) {
                console.warn("Could not assign dropped file.", error);
            }
        });
    }

    /* Analysis loading overlay */
    if (analysisForm && runButton) {
        let isSubmitting = false;

        analysisForm.addEventListener("submit", event => {
            if (isSubmitting) {
                event.preventDefault();
                return;
            }

            // Keep browser validation and the existing Django form submission.
            if (!analysisForm.checkValidity()) return;

            isSubmitting = true;
            runButton.classList.add("loading");
            runButton.setAttribute("aria-busy", "true");

            const buttonText = runButton.querySelector("span");
            if (buttonText) buttonText.textContent = "Analyzing…";

            let overlay = document.getElementById("eigenLoadingOverlay");

            if (!overlay) {
                overlay = document.createElement("div");
                overlay.id = "eigenLoadingOverlay";
                overlay.className = "eigen-loading-overlay";
                overlay.setAttribute("role", "status");
                overlay.setAttribute("aria-live", "polite");

                overlay.innerHTML = `
                    <div class="eigen-loading-card">
                        <div class="eigen-loader-mark" aria-hidden="true">
                            <span>λ</span>
                        </div>
                        <p class="eigen-loading-eyebrow">
                            EIGENLAB · COMPUTATION IN PROGRESS
                        </p>
                        <h2>Turning pixels into mathematics.</h2>
                        <p class="eigen-loading-description">
                            Preparing your image for analysis.
                        </p>
                        <div class="eigen-loading-track">
                            <span></span>
                        </div>
                        <div class="eigen-loading-stages">
                            <span class="active">01&nbsp; Prepare image</span>
                            <span>02&nbsp; Build matrix</span>
                            <span>03&nbsp; Compute features</span>
                            <span>04&nbsp; Reconstruct</span>
                        </div>
                        <p class="eigen-loading-footnote">
                            Please keep this tab open while analysis runs.
                        </p>
                    </div>`;

                document.body.appendChild(overlay);
            }

            // These are illustrative stages, not measured backend progress.
            const stages = overlay.querySelectorAll(
                ".eigen-loading-stages span"
            );
            const description = overlay.querySelector(
                ".eigen-loading-description"
            );

            const messages = [
                "Preparing your image for analysis.",
                "Building the mathematical matrix representation.",
                "Computing the selected eigen-features.",
                "Preparing the reconstruction and result summaries."
            ];

            let stageIndex = 0;

            const stageInterval = window.setInterval(() => {
                if (!overlay.isConnected) {
                    window.clearInterval(stageInterval);
                    return;
                }

                stageIndex = Math.min(stageIndex + 1, stages.length - 1);

                stages.forEach((stage, index) => {
                    stage.classList.toggle("active", index === stageIndex);
                    stage.classList.toggle("complete", index < stageIndex);
                });

                if (description) {
                    description.textContent = messages[stageIndex];
                }

                if (stageIndex >= stages.length - 1) {
                    window.clearInterval(stageInterval);
                }
            }, 1700);
        });

        // Restore the UI when navigating back to this page.
        window.addEventListener("pageshow", () => {
            isSubmitting = false;
            runButton.classList.remove("loading");
            runButton.removeAttribute("aria-busy");

            const buttonText = runButton.querySelector("span");
            if (buttonText) buttonText.textContent = "Run Analysis";

            document.getElementById("eigenLoadingOverlay")?.remove();
        });
    }

    /* Eigenvalue chart */
    const canvas = document.getElementById("eigenChart");

    if (!canvas) return;

    const rawValues = canvas.dataset.values || "";
    const values = rawValues
        .split(",")
        .map(value => Number(value.trim()))
        .filter(Number.isFinite);

    if (!values.length) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    function drawEigenvalueChart() {
        const width = canvas.clientWidth;
        const height = 230;
        if (!width) return;

        const dpr = window.devicePixelRatio || 1;

        canvas.width = Math.max(1, Math.floor(width * dpr));
        canvas.height = Math.floor(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        ctx.clearRect(0, 0, width, height);
        ctx.fillStyle = "#05070c";
        ctx.fillRect(0, 0, width, height);

        const padding = {
            top: 22,
            right: 18,
            bottom: 35,
            left: 48
        };

        const chartWidth = width - padding.left - padding.right;
        const chartHeight = height - padding.top - padding.bottom;
        const maxValue = Math.max(...values, 1);

        ctx.font = '9px "JetBrains Mono", "Cascadia Code", Consolas, monospace';
        ctx.lineWidth = 1;
        ctx.strokeStyle = "rgba(246,238,230,.10)";
        ctx.fillStyle = "#747a8a";

        for (let i = 0; i <= 4; i++) {
            const ratio = i / 4;
            const y = padding.top + chartHeight - ratio * chartHeight;

            ctx.beginPath();
            ctx.moveTo(padding.left, y);
            ctx.lineTo(width - padding.right, y);
            ctx.stroke();

            ctx.textAlign = "right";
            ctx.fillText(
                (maxValue * ratio).toPrecision(3),
                padding.left - 8,
                y + 3
            );
        }

        const count = values.length;
        const gap = count > 50 ? 1 : 3;
        const barWidth = Math.max(
            1,
            (chartWidth - gap * (count - 1)) / count
        );

        values.forEach((value, index) => {
            const normalized = Math.max(0, Math.min(1, value / maxValue));
            const barHeight = normalized * chartHeight;
            const x = padding.left + index * (barWidth + gap);
            const y = padding.top + chartHeight - barHeight;

            ctx.fillStyle = index < 5
                ? "#d8b36a"
                : index < 10
                    ? "#a8884e"
                    : "rgba(216,179,106,.28)";

            ctx.fillRect(x, y, barWidth, barHeight);
        });

        ctx.strokeStyle = "rgba(246,238,230,.22)";
        ctx.beginPath();
        ctx.moveTo(padding.left, padding.top + chartHeight);
        ctx.lineTo(width - padding.right, padding.top + chartHeight);
        ctx.stroke();

        ctx.fillStyle = "#747a8a";
        ctx.font = '8px "JetBrains Mono", "Cascadia Code", Consolas, monospace';
        ctx.textAlign = "center";

        [1, 5, 10, 20, 32, 64].forEach(label => {
            if (label > count) return;

            const index = label - 1;
            const x = padding.left + index * (barWidth + gap) + barWidth / 2;
            ctx.fillText(`λ${label}`, x, height - 13);
        });

        ctx.font = '8px "JetBrains Mono", "Cascadia Code", Consolas, monospace';
        ctx.textAlign = "left";
        ctx.fillText("EIGENVALUE MAGNITUDE", padding.left, 12);

        ctx.textAlign = "right";
        ctx.fillText(`${count} COMPONENTS`, width - padding.right, 12);
    }

    drawEigenvalueChart();

    if ("ResizeObserver" in window) {
        const observer = new ResizeObserver(drawEigenvalueChart);
        observer.observe(canvas);
    } else {
        window.addEventListener("resize", drawEigenvalueChart);
    }
});